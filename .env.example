# Copy to .env and fill in the keys for the providers you want to use.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: point the OpenAI adapter at a compatible endpoint
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=

# Ollama (local) — base URL of the running daemon
OLLAMA_BASE_URL=http://localhost:11434

# Default provider + model used when not overridden via CLI flags.
LUCKY_PROVIDER=claude
LUCKY_MODEL=claude-sonnet-4-6

# Optional tool permission overrides. Format: tool=allow|ask|deny,pattern*=allow|ask|deny
# Defaults allow read-only tools, ask for write/edit/patch/exec, and ask for unknown tools.
# Example: deny shell execution and always allow patch edits:
# LUCKY_TOOL_PERMISSIONS=exec=deny,apply_patch=allow,mcp_*=ask
