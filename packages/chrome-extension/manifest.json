{
  "manifest_version": 3,
  "name": "Lucky",
  "version": "0.1.0",
  "description": "Connects the Lucky CLI to your Chrome tabs through a loopback bridge.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Lucky"
  }
}
